# Local Python environment
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets and local env
.env
.env.*
!.env.example

# Model weights and trainer dumps
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.gguf

# Run logs and status files (drivers write these next to cwd)
logs/
*.log
*_status.txt
*_driver.log
*.part

# Leftover worlds from the parent harness (not part of MZ01)
archive/

# Experiment runtime artifacts — keep SPEC/plans, not captures
experiments/**/adapters/
experiments/**/resid/
experiments/**/results/parallel/

# New result dumps stay local. Already-tracked pilot JSON and navigator
# summaries remain in git; un-ignore those paths so `git add` still works.
experiments/**/results/
!experiments/v2/MZ01_maze_world/results/
experiments/v2/MZ01_maze_world/results/**
!experiments/v2/MZ01_maze_world/results/pilot/
!experiments/v2/MZ01_maze_world/results/pilot/**
!experiments/v2/MZ01_maze_world/results/navigator/
!experiments/v2/MZ01_maze_world/results/navigator/*.json

# Scratch from older harness notes
compute_ledger.md.venv-writing/
wandb/
lightning_logs/
runs/
outputs/

# Subagent git worktrees (transient session infrastructure, never committed)
.claude/worktrees/

# THIS BATCH'S TRIAL TRACES ARE TRACKED, against the rule above (2026-09-10).
# The rule keeps run output out of the repository because it normally lives on
# the workstation that pulled it. The 2026-09-10 session runs in an EPHEMERAL
# container: when it is reclaimed, anything not pushed is gone, and every number
# in PLAN-fork-counterfactual.md §16-§18 cites these files by name. The JSON and
# the run log are kept (about 150 KB an arm); the .pt adapters are not.
!experiments/v2/MZ01_maze_world/results/forkcf4b_*/
!experiments/v2/MZ01_maze_world/results/forkcf4b_*/*.json
!experiments/v2/MZ01_maze_world/results/forkcf4b_*/*.log
