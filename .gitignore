# Run logs and status files (drivers write these next to cwd)
logs/
*.log
*_status.txt
*_driver.log
*.part

# Leftover worlds from the parent harness (not part of MZ01)
archive/

# Experiment runtime artifacts — keep SPEC/plans, not captures
experiments/**/adapters/
experiments/**/resid/
experiments/**/results/parallel/

# New result dumps stay local. Already-tracked pilot JSON and navigator
# summaries remain in git; un-ignore those paths so `git add` still works.
experiments/**/results/
!experiments/v2/MZ01_maze_world/results/
experiments/v2/MZ01_maze_world/results/**
!experiments/v2/MZ01_maze_world/results/pilot/
!experiments/v2/MZ01_maze_world/results/pilot/**
!experiments/v2/MZ01_maze_world/results/navigator/
!experiments/v2/MZ01_maze_world/results/navigator/*.json

# Scratch from older harness notes
compute_ledger.md.venv-writing/
wandb/
lightning_logs/
runs/
outputs/
